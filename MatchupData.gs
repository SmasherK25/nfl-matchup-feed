var MatchupData=(function(){
  var metricSpecs={passEPA:['passEPA','passN',0],passSuccess:['passSuccess','passN',.45],sackRate:['sacks','dropbacks',.065],scrambleRate:['scrambles','dropbacks',.065],spikeRate:['spikes','attempts',.01],targetRate:['targets','attempts',.93],catchRate:['receptions','targets',.65],passYpc:['passingYards','receptions',11],rushYpc:['rushingYards','carries',4.3],rushEPA:['rushEPA','rushN',0],rushSuccess:['rushSuccess','rushN',.42],passExplosive:['passExplosive','dropbacks',.1],rushExplosive:['rushExplosive','carries',.12]};
  function totals(f){var out={};Object.keys(metricSpecs).forEach(function(k){var m=metricSpecs[k];out[k]=f[m[1]]>0?f[m[0]]/f[m[1]]:m[2];});return out;}
  function pos(f,position){var out={targets:0,receptions:0,receivingYards:0,carries:0,rushingYards:0};(f.cells||[]).forEach(function(c){(c.players||[]).forEach(function(p){if(p.position===position)Object.keys(out).forEach(function(k){out[k]+=p[k]||0;});});});return out;}
  function weighted(records,season){var current=records.filter(function(f){return f.season===season;}),prior=records.filter(function(f){return f.season===season-1;}),out=[];
    [current,prior].forEach(function(rs,which){rs=rs.slice().sort(function(a,b){return b.kickoffAt-a.kickoffAt;});var weights=rs.map(function(f,i){return HistoryEngine.weight(i,'exp10');}),sum=Util.sum(weights),budget=which?4.8:rs.length;rs.forEach(function(f,i){out.push({f:f,w:sum?weights[i]*budget/sum:0});});});return out;
  }
  function offense(records,season){var rows=weighted(records,season),out={},weight=Util.sum(rows.map(function(r){return r.w;}));
    Object.keys(metricSpecs).forEach(function(k){var m=metricSpecs[k],n=0,d=0;rows.forEach(function(r){n+=r.w*r.f[m[0]];d+=r.w*r.f[m[1]];});out[k]=d?n/d:m[2];});
    ['plays','dropbacks','attempts','targets','carries','kneels'].forEach(function(k){out[k]=weight?Util.sum(rows.map(function(r){return r.w*r.f[k];}))/weight:k==='plays'?63:k==='attempts'?33:k==='targets'?30:k==='carries'?25:k==='dropbacks'?36:1;});
    out.positions={};['RB','WR','TE','UNASSIGNED'].forEach(function(p){var n={targets:0,receptions:0,receivingYards:0,carries:0,rushingYards:0};rows.forEach(function(r){var v=r.f.positions?r.f.positions[p]:pos(r.f,p);Object.keys(n).forEach(function(k){n[k]+=r.w*(v[k]||0);});});out.positions[p]={targetShare:n.targets/Math.max(1,Util.sum(rows.map(function(r){return r.w*r.f.targets;}))),catchRate:n.targets?n.receptions/n.targets:.65,ypr:n.receptions?n.receivingYards/n.receptions:p==='RB'?7:12,ypc:n.carries?n.rushingYards/n.carries:4.3};});return out;
  }
  function defense(records,season,prior){var rows=weighted(records,season),out={n:rows.length,raw:{},adjusted:{},positions:{}},games=Util.sum(rows.map(function(r){return r.w;}));
    Object.keys(metricSpecs).forEach(function(k){var m=metricSpecs[k],n=0,d=0,res=0;rows.forEach(function(r){n+=r.w*r.f[m[0]];d+=r.w*r.f[m[1]];res+=r.w*(r.f[m[0]]-r.f[m[1]]*(r.f.before?r.f.before[k]:m[2]));});out.raw[k]=d?n/d:null;out.adjusted[k]=res/(d+prior);});
    ['attempts','passingYards','receptions','targets','carries','rushingYards','plays','drives'].forEach(function(k){out.raw[k+'PerGame']=games?Util.sum(rows.map(function(r){return r.w*r.f[k];}))/games:null;});
    ['RB','WR','TE','UNASSIGNED'].forEach(function(p){var n={targets:0,receptions:0,receivingYards:0,carries:0,rushingYards:0},res={targetShare:0,catchRate:0,ypr:0,ypc:0},allTargets=0;
      rows.forEach(function(r){var v=r.f.positions?r.f.positions[p]:pos(r.f,p),b=r.f.before&&r.f.before.positions?r.f.before.positions[p]:{targetShare:p==='WR'?.6:p==='TE'?.2:.2,catchRate:.65,ypr:p==='RB'?7:12,ypc:4.3};Object.keys(n).forEach(function(k){n[k]+=r.w*(v[k]||0);});allTargets+=r.w*r.f.targets;res.targetShare+=r.w*(v.targets-r.f.targets*b.targetShare);res.catchRate+=r.w*(v.receptions-v.targets*b.catchRate);res.ypr+=r.w*(v.receivingYards-v.receptions*b.ypr);res.ypc+=r.w*(v.rushingYards-v.carries*b.ypc);});
      out.positions[p]={opportunities:n.targets,raw:{targetsPerGame:games?n.targets/games:null,receptionsPerGame:games?n.receptions/games:null,yardsPerGame:games?n.receivingYards/games:null,catchRate:n.targets?n.receptions/n.targets:null,ypr:n.receptions?n.receivingYards/n.receptions:null,ypc:n.carries?n.rushingYards/n.carries:null},adjusted:{targetShare:res.targetShare/(allTargets+prior),catchRate:res.catchRate/(n.targets+prior),ypr:res.ypr/(n.receptions+prior),ypc:res.ypc/(n.carries+prior)}};
    });return out;
  }
  function visible(feed,cutoff){return (feed.facts||[]).filter(function(f){return f.availableAt<=cutoff&&f.kickoffAt<cutoff;});}
  function roles(team){var out={},rbs=team.players.filter(function(m){return m.target.position==='RB';}).sort(function(a,b){return b.expected.carries-a.expected.carries;}),receivers=team.players.filter(function(m){return m.target.position==='WR';}).sort(function(a,b){return b.expected.targets-a.expected.targets;}),catchRb=rbs.slice().sort(function(a,b){return b.expected.targets-a.expected.targets;})[0];
    team.players.forEach(function(m){var p=m.target.position;out[m.playerId]=p==='QB'?(m.playerId===team.role.starterId?'QB_STARTER':'QB_BACKUP'):p==='RB'?(rbs[0]===m?(catchRb===m?'RB_LEAD_RECEIVING':'RB_LEAD'):catchRb===m?'RB_RECEIVING':'RB_OTHER'):p==='WR'?(receivers[0]===m?'WR_LEAD':'WR_OTHER'):p;});return out;
  }
  function ratingVector(profile,p){var x=profile||{adjusted:{},positions:{}},v=x.positions[p]?x.positions[p].adjusted:{};return [x.adjusted.passEPA||0,x.adjusted.passSuccess||0,x.adjusted.sackRate||0,x.adjusted.rushEPA||0,x.adjusted.rushSuccess||0,v.targetShare||0,v.catchRate||0,v.ypr||0,v.ypc||0];}
  return {metricSpecs:metricSpecs,totals:totals,pos:pos,weighted:weighted,offense:offense,defense:defense,visible:visible,roles:roles,ratingVector:ratingVector};
})();
